  "scripts": {
    "compile": "tsc -p ./ && npm run bundle-server",
    "bundle-server": "esbuild src/mcp/server.ts --bundle --platform=node --target=node18 --outfile=out/mcp/server.js && esbuild src/mcp/run-task.ts --bundle --platform=node --target=node18 --outfile=out/mcp/run-task.js && esbuild src/mcp/provider-cli.ts --bundle --platform=node --target=node18 --outfile=out/mcp/provider-cli.js && esbuild src/mcp/cli.ts --bundle --platform=node --target=node18 --outfile=out/mcp/cli.js",
    "watch": "tsc -watch -p ./",
    "vscode:prepublish": "node -e \"require('fs').rmSync('out',{recursive:true,force:true})\" && npm run compile",
    "package": "vsce package",
    "publish": "vsce publish",
    "publish:ovsx": "ovsx publish",
    "publish:all": "vsce package && vsce publish --packagePath claude-code-orchestrator-$npm_package_version.vsix && ovsx publish claude-code-orchestrator-$npm_package_version.vsix"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/vscode": "^1.90.0",
    "@vscode/vsce": "^3.0.0",
    "esbuild": "^0.28.1",
    "ovsx": "^0.10.12",
    "typescript": "^5.6.0"
  },
