{
  "name": "claude-code-orchestrator",
  "displayName": "Claude Code Orchestrator",
  "description": "%extension.description%",
  "version": "1.5.1",
  "publisher": "toragonite",
  "license": "MIT",
  "icon": "media/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/Toragonite/claude-code-orchestrator.git"
  },
  "homepage": "https://github.com/Toragonite/claude-code-orchestrator#readme",
  "bugs": {
    "url": "https://github.com/Toragonite/claude-code-orchestrator/issues"
  },
  "qna": "marketplace",
  "keywords": [
    "claude",
    "claude-code",
    "anthropic",
    "mcp",
    "model context protocol",
    "multi-account",
    "orchestration",
    "orchestrator",
    "agent",
    "agents",
    "subagent",
    "ai agent",
    "parallel",
    "dispatch",
    "worker",
    "opus",
    "sonnet",
    "quota",
    "failover",
    "usage tracking",
    "dashboard",
    "cli",
    "automation",
    "coding agent",
    "llm"
  ],
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Machine Learning",
    "Other"
  ],
  "main": "./out/extension.js",
  "l10n": "./l10n",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "claudeCodeOrchestrator",
          "title": "%viewsContainer.title%",
          "icon": "$(organization)"
        }
      ]
    },
    "views": {
      "claudeCodeOrchestrator": [
        {
          "id": "claudeCodeOrchestrator.workers",
          "name": "%view.workers.name%",
          "icon": "$(server-process)"
        },
        {
          "id": "claudeCodeOrchestrator.tasks",
          "name": "%view.tasks.name%",
          "icon": "$(checklist)"
        },
        {
          "id": "claudeCodeOrchestrator.workerHistory",
          "name": "%view.workerHistory.name%",
          "icon": "$(history)"
        }
      ]
    },
    "commands": [
      {
        "command": "claudeCodeOrchestrator.addWorker",
        "title": "%command.addWorker.title%",
        "category": "%command.category%",
        "icon": "$(add)"
      },
      {
        "command": "claudeCodeOrchestrator.importWorkers",
        "title": "%command.importWorkers.title%",
        "category": "%command.category%",
        "icon": "$(cloud-download)"
      },
      {
        "command": "claudeCodeOrchestrator.removeWorker",
        "title": "%command.removeWorker.title%",
        "category": "%command.category%",
        "icon": "$(trash)"
      },
      {
        "command": "claudeCodeOrchestrator.renameWorker",
        "title": "Rename Worker Account",
        "category": "Claude Code Orchestrator",
        "icon": "$(edit)"
      },
      {
        "command": "claudeCodeOrchestrator.loginWorker",
        "title": "%command.loginWorker.title%",
        "category": "%command.category%",
        "icon": "$(sign-in)"
      },
      {
        "command": "claudeCodeOrchestrator.reloginWorker",
        "title": "Re-login Account (opens `claude auth login`)",
        "category": "Claude Code Orchestrator",
        "icon": "$(sign-in)"
      },
      {
        "command": "claudeCodeOrchestrator.openWorkerSession",
        "title": "%command.openWorkerSession.title%",
        "category": "%command.category%",
        "icon": "$(terminal)"
      },
      {
        "command": "claudeCodeOrchestrator.installMcp",
        "title": "%command.installMcp.title%",
        "category": "%command.category%",
        "icon": "$(plug)"
      },
      {
        "command": "claudeCodeOrchestrator.showTaskOutput",
        "title": "%command.showTaskOutput.title%",
        "category": "Claude Code Orchestrator"
      },
      {
        "command": "claudeCodeOrchestrator.clearTasks",
        "title": "%command.clearTasks.title%",
        "category": "%command.category%",
        "icon": "$(clear-all)"
      },
      {
        "command": "claudeCodeOrchestrator.cancelTask",
        "title": "Cancel Dispatched Task",
        "category": "Claude Code Orchestrator",
        "icon": "$(stop-circle)"
      },
      {
        "command": "claudeCodeOrchestrator.cancelAllTasks",
        "title": "Cancel All Running Dispatches",
        "category": "Claude Code Orchestrator",
        "icon": "$(stop)"
      },
      {
        "command": "claudeCodeOrchestrator.togglePreferred",
        "title": "%command.togglePreferred.title%",
        "category": "%command.category%",
        "icon": "$(star)"
      },
      {
        "command": "claudeCodeOrchestrator.toggleTaskScope",
        "title": "%command.toggleTaskScope.title%",
        "category": "%command.category%",
        "icon": "$(filter)"
      },
      {
        "command": "claudeCodeOrchestrator.openDashboard",
        "title": "%command.openDashboard.title%",
        "category": "%command.category%",
        "icon": "$(dashboard)"
      },
      {
        "command": "claudeCodeOrchestrator.addDispatchPolicy",
        "title": "%command.addDispatchPolicy.title%",
        "category": "%command.category%",
        "icon": "$(book)"
      },
      {
        "command": "claudeCodeOrchestrator.refreshUsage",
        "title": "Refresh Account Usage",
        "category": "Claude Code Orchestrator",
        "icon": "$(sync)"
      },
      {
        "command": "claudeCodeOrchestrator.openAssetManager",
        "title": "%command.openAssetManager.title%",
        "category": "%command.category%",
        "icon": "$(library)"
      },
      {
        "command": "claudeCodeOrchestrator.manageAssets",
        "title": "%command.manageAssets.title%",
        "category": "%command.category%",
        "icon": "$(checklist)"
      },
      {
        "command": "claudeCodeOrchestrator.syncAssets",
        "title": "%command.syncAssets.title%",
        "category": "%command.category%",
        "icon": "$(sync)"
      },
      {
        "command": "claudeCodeOrchestrator.resetAsset",
        "title": "%command.resetAsset.title%",
        "category": "%command.category%",
        "icon": "$(discard)"
      },
      {
        "command": "claudeCodeOrchestrator.attachMeshWorker",
        "title": "%command.attachMeshWorker.title%",
        "category": "%command.category%",
        "icon": "$(terminal)"
      },
      {
        "command": "claudeCodeOrchestrator.meshWorkerLogs",
        "title": "%command.meshWorkerLogs.title%",
        "category": "%command.category%",
        "icon": "$(output)"
      },
      {
        "command": "claudeCodeOrchestrator.stopMeshWorker",
        "title": "%command.stopMeshWorker.title%",
        "category": "%command.category%",
        "icon": "$(stop-circle)"
      },
      {
        "command": "claudeCodeOrchestrator.clearStoppedWorkers",
        "title": "%command.clearStoppedWorkers.title%",
        "category": "%command.category%",
        "icon": "$(clear-all)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "claudeCodeOrchestrator.openDashboard",
          "when": "view == claudeCodeOrchestrator.workers",
          "group": "navigation@0"
        },
        {
          "command": "claudeCodeOrchestrator.addWorker",
          "when": "view == claudeCodeOrchestrator.workers",
          "group": "navigation@1"
        },
        {
          "command": "claudeCodeOrchestrator.importWorkers",
          "when": "view == claudeCodeOrchestrator.workers",
          "group": "navigation@2"
        },
        {
          "command": "claudeCodeOrchestrator.installMcp",
          "when": "view == claudeCodeOrchestrator.workers",
          "group": "navigation@3"
        },
        {
          "command": "claudeCodeOrchestrator.refreshUsage",
          "when": "view == claudeCodeOrchestrator.workers",
          "group": "navigation@4"
        },
        {
          "command": "claudeCodeOrchestrator.openAssetManager",
          "when": "view == claudeCodeOrchestrator.workers",
          "group": "navigation@5"
        },
        {
          "command": "claudeCodeOrchestrator.cancelAllTasks",
          "when": "view == claudeCodeOrchestrator.tasks",
          "group": "navigation@0"
        },
        {
          "command": "claudeCodeOrchestrator.toggleTaskScope",
          "when": "view == claudeCodeOrchestrator.tasks",
          "group": "navigation@1"
        },
        {
          "command": "claudeCodeOrchestrator.openDashboard",
          "when": "view == claudeCodeOrchestrator.tasks",
          "group": "navigation@2"
        },
        {
          "command": "claudeCodeOrchestrator.clearTasks",
          "when": "view == claudeCodeOrchestrator.tasks",
          "group": "navigation@3"
        }
      ],
      "view/item/context": [
        {
          "command": "claudeCodeOrchestrator.cancelTask",
          "when": "view == claudeCodeOrchestrator.tasks && viewItem == runningTask",
          "group": "inline"
        },
        {
          "command": "claudeCodeOrchestrator.openWorkerSession",
          "when": "view == claudeCodeOrchestrator.workers && viewItem == worker",
          "group": "inline"
        },
        {
          "command": "claudeCodeOrchestrator.togglePreferred",
          "when": "view == claudeCodeOrchestrator.workers && viewItem == worker",
          "group": "1_manage@0"
        },
        {
          "command": "claudeCodeOrchestrator.renameWorker",
          "when": "view == claudeCodeOrchestrator.workers && viewItem == worker",
          "group": "1_manage@1"
        },
        {
          "command": "claudeCodeOrchestrator.loginWorker",
          "when": "view == claudeCodeOrchestrator.workers && viewItem == worker",
          "group": "1_manage@2"
        },
        {
          "command": "claudeCodeOrchestrator.reloginWorker",
          "when": "view == claudeCodeOrchestrator.workers && viewItem == worker",
          "group": "1_manage@3"
        },
        {
          "command": "claudeCodeOrchestrator.removeWorker",
          "when": "view == claudeCodeOrchestrator.workers && viewItem == worker",
          "group": "1_manage@4"
        },
        {
          "command": "claudeCodeOrchestrator.attachMeshWorker",
          "when": "view == claudeCodeOrchestrator.workers && viewItem == meshWorker",
          "group": "inline@0"
        },
        {
          "command": "claudeCodeOrchestrator.meshWorkerLogs",
          "when": "view == claudeCodeOrchestrator.workers && viewItem == meshWorker",
          "group": "inline@1"
        },
        {
          "command": "claudeCodeOrchestrator.stopMeshWorker",
          "when": "view == claudeCodeOrchestrator.workers && viewItem == meshWorker",
          "group": "1_manage@0"
        },
        {
          "command": "claudeCodeOrchestrator.clearStoppedWorkers",
          "when": "view == claudeCodeOrchestrator.workers && viewItem == meshGroup",
          "group": "inline@0"
        }
      ]
    },
    "walkthroughs": [
      {
        "id": "claudeCodeOrchestrator.gettingStarted",
        "title": "%walkthrough.title%",
        "description": "%walkthrough.description%",
        "steps": [
          {
            "id": "addWorker",
            "title": "%walkthrough.step.addWorker.title%",
            "description": "%walkthrough.step.addWorker.description%",
            "media": {
              "markdown": "media/walkthrough/add-worker.md"
            },
            "completionEvents": [
              "onCommand:claudeCodeOrchestrator.addWorker",
              "onCommand:claudeCodeOrchestrator.importWorkers"
            ]
          },
          {
            "id": "registerMcp",
            "title": "%walkthrough.step.registerMcp.title%",
            "description": "%walkthrough.step.registerMcp.description%",
            "media": {
              "markdown": "media/walkthrough/register-mcp.md"
            },
            "completionEvents": [
              "onCommand:claudeCodeOrchestrator.installMcp"
            ]
          },
          {
            "id": "useDispatch",
            "title": "%walkthrough.step.useDispatch.title%",
            "description": "%walkthrough.step.useDispatch.description%",
            "media": {
              "markdown": "media/walkthrough/use-dispatch.md"
            }
          },
          {
            "id": "meshMode",
            "title": "%walkthrough.step.meshMode.title%",
            "description": "%walkthrough.step.meshMode.description%",
            "media": {
              "markdown": "media/walkthrough/mesh-mode.md"
            },
            "completionEvents": [
              "onSettingChanged:claudeCodeOrchestrator.meshMode"
            ]
          }
        ]
      }
    ],
    "configuration": {
      "title": "%configuration.title%",
      "properties": {
        "claudeCodeOrchestrator.workerPermissionMode": {
          "type": "string",
          "default": "acceptEdits",
          "enum": [
            "default",
            "acceptEdits",
            "plan",
            "bypassPermissions"
          ],
          "description": "%config.workerPermissionMode.description%"
        },
        "claudeCodeOrchestrator.claudePath": {
          "type": "string",
          "default": "claude",
          "description": "%config.claudePath.description%"
        },
        "claudeCodeOrchestrator.quotaCooldownMinutes": {
          "type": "number",
          "default": 30,
          "description": "%config.quotaCooldownMinutes.description%"
        },
        "claudeCodeOrchestrator.workerTimeoutMinutes": {
          "type": "number",
          "default": 45,
          "minimum": 1,
          "maximum": 480,
          "description": "%config.workerTimeoutMinutes.description%"
        },
        "claudeCodeOrchestrator.assetPacks": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "%config.assetPacks.description%"
        },
        "claudeCodeOrchestrator.assetAutoSync": {
          "type": "boolean",
          "default": true,
          "description": "%config.assetAutoSync.description%"
        },
        "claudeCodeOrchestrator.frontierWorkerDispatch": {
          "type": "string",
          "default": "block",
          "enum": [
            "block",
            "allow"
          ],
          "enumDescriptions": [
            "%config.frontierWorkerDispatch.enumDescription.block%",
            "%config.frontierWorkerDispatch.enumDescription.allow%"
          ],
          "description": "%config.frontierWorkerDispatch.description%"
        },
        "claudeCodeOrchestrator.overageWorkerDispatch": {
          "type": "string",
          "default": "block",
          "enum": [
            "block",
            "allow"
          ],
          "enumDescriptions": [
            "Never assign work to a quota-exhausted worker, even when that account has extra usage enabled — dispatch never spends money past a plan window.",
            "Exhausted workers with extra usage enabled may be used as a last resort. Those dispatches bill real money against the account's monthly cap."
          ],
          "description": "Billing guard for overage (extra-credit) dispatches. 'block' (default): the dispatch server never assigns work to a quota-exhausted worker, even when that account has extra usage enabled — dispatch never spends money past a plan window. 'allow': exhausted workers with extra usage enabled may be used as a last resort; those dispatches bill real money against the account's monthly cap. Independent of frontierWorkerDispatch, which only controls the claude-fable-5 model."
        },
        "claudeCodeOrchestrator.sessionKeepalive": {
          "type": "boolean",
          "default": false,
          "description": "Send one minimal Claude request (haiku model) per subscription account per 24h to keep OAuth sessions fresh. Spends a negligible amount of plan usage. Off by default; recovery from an already-expired login is the Re-login command."
        },
        "claudeCodeOrchestrator.meshMode": {
          "type": "boolean",
          "default": false,
          "description": "%config.meshMode.description%"
        },
        "claudeCodeOrchestrator.meshGatewayModel": {
          "type": "string",
          "default": "haiku",
          "enum": [
            "haiku",
            "sonnet"
          ],
          "enumDescriptions": [
            "%config.meshGatewayModel.enumDescription.haiku%",
            "%config.meshGatewayModel.enumDescription.sonnet%"
          ],
          "description": "%config.meshGatewayModel.description%"
        },
        "claudeCodeOrchestrator.meshWorkerIdleTimeoutMin": {
          "type": "number",
          "default": 15,
          "minimum": 0,
          "maximum": 1440,
          "description": "%config.meshWorkerIdleTimeoutMin.description%"
        },
        "claudeCodeOrchestrator.meshMaxLiveWorkers": {
          "type": "number",
          "default": 8,
          "minimum": 1,
          "maximum": 64,
          "description": "%config.meshMaxLiveWorkers.description%"
        },
        "claudeCodeOrchestrator.meshHistoryLimit": {
          "type": "integer",
          "default": 50,
          "minimum": 1,
          "maximum": 1000,
          "description": "%config.meshHistoryLimit.description%"
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p ./ && npm run bundle-server",
    "bundle-server": "esbuild src/mcp/server.ts --bundle --platform=node --target=node18 --outfile=out/mcp/server.js && esbuild src/mcp/run-task.ts --bundle --platform=node --target=node18 --outfile=out/mcp/run-task.js",
    "watch": "tsc -watch -p ./",
    "vscode:prepublish": "npm run compile",
    "package": "vsce package",
    "publish": "vsce publish",
    "publish:ovsx": "ovsx publish",
    "publish:all": "vsce package && vsce publish --packagePath claude-code-orchestrator-$npm_package_version.vsix && ovsx publish claude-code-orchestrator-$npm_package_version.vsix"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/vscode": "^1.90.0",
    "@vscode/vsce": "^3.0.0",
    "esbuild": "^0.28.1",
    "ovsx": "^0.10.12",
    "typescript": "^5.6.0"
  },
  "galleryBanner": {
    "color": "#1b1b2f",
    "theme": "dark"
  }
}
