{
  "name": "claude-code-orchestrator",
  "displayName": "Claude Code Orchestrator",
  "description": "%extension.description%",
  "version": "2.0.1",
  "publisher": "toragonite",
  "license": "MIT",
  "icon": "media/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/Toragonite/claude-code-orchestrator.git"
  },
  "homepage": "https://github.com/Toragonite/claude-code-orchestrator#readme",
  "bugs": {
    "url": "https://github.com/Toragonite/claude-code-orchestrator/issues"
  },
  "qna": "marketplace",
  "keywords": [
    "claude",
    "claude-code",
    "anthropic",
    "mcp",
    "model context protocol",
    "multi-account",
    "orchestration",
    "orchestrator",
    "agent",
    "agents",
    "subagent",
    "ai agent",
    "parallel",
    "dispatch",
    "worker",
    "opus",
    "sonnet",
    "quota",
    "failover",
    "usage tracking",
    "dashboard",
    "cli",
    "automation",
    "coding agent",
    "llm"
  ],
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Machine Learning",
    "Other"
  ],
  "main": "./out/extension.js",
  "l10n": "./l10n",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "claudeCodeOrchestrator",
          "title": "%viewsContainer.title%",
          "icon": "$(organization)"
        }
      ]
    },
    "views": {
      "claudeCodeOrchestrator": [
        {
          "id": "claudeCodeOrchestrator.workers",
          "name": "%view.workers.name%",
          "icon": "$(server-process)"
        },
        {
          "id": "claudeCodeOrchestrator.team",
          "name": "%view.team.name%",
          "icon": "$(broadcast)"
        },
        {
          "id": "claudeCodeOrchestrator.tasks",
          "name": "%view.tasks.name%",
          "icon": "$(checklist)"
        },
        {
          "id": "claudeCodeOrchestrator.workerHistory",
          "name": "%view.workerHistory.name%",
          "icon": "$(history)"
        }
      ]
    },
    "commands": [
      {
        "command": "claudeCodeOrchestrator.addWorker",
        "title": "%command.addWorker.title%",
        "category": "%command.category%",
        "icon": "$(add)"
      },
      {
        "command": "claudeCodeOrchestrator.importWorkers",
        "title": "%command.importWorkers.title%",
        "category": "%command.category%",
        "icon": "$(cloud-download)"
      },
      {
        "command": "claudeCodeOrchestrator.removeWorker",
        "title": "%command.removeWorker.title%",
        "category": "%command.category%",
        "icon": "$(trash)"
      },
      {
        "command": "claudeCodeOrchestrator.removeUnsupportedEntry",
        "title": "%command.removeUnsupportedEntry.title%",
        "category": "%command.category%",
        "icon": "$(trash)"
      },
      {
        "command": "claudeCodeOrchestrator.renameWorker",
        "title": "%command.renameWorker.title%",
        "category": "%command.category%",
        "icon": "$(edit)"
      },
      {
        "command": "claudeCodeOrchestrator.setWorkerModel",
        "title": "%command.setWorkerModel.title%",
        "category": "%command.category%",
        "icon": "$(symbol-enum)"
      },
      {
        "command": "claudeCodeOrchestrator.setWorkerPermissionMode",
        "title": "%command.setWorkerPermissionMode.title%",
        "category": "%command.category%",
        "icon": "$(shield)"
      },
      {
        "command": "claudeCodeOrchestrator.loginWorker",
        "title": "%command.loginWorker.title%",
        "category": "%command.category%",
        "icon": "$(sign-in)"
      },
      {
        "command": "claudeCodeOrchestrator.reloginWorker",
        "title": "%command.reloginWorker.title%",
        "category": "%command.category%",
        "icon": "$(sign-in)"
      },
      {
        "command": "claudeCodeOrchestrator.checkLoginNow",
        "title": "%command.checkLoginNow.title%",
        "category": "%command.category%",
        "icon": "$(pass)"
      },
      {
        "command": "claudeCodeOrchestrator.showLoginDiagnostics",
        "title": "%command.showLoginDiagnostics.title%",
        "category": "%command.category%",
        "icon": "$(output)"
      },
      {
        "command": "claudeCodeOrchestrator.openWorkerSession",
        "title": "%command.openWorkerSession.title%",
        "category": "%command.category%",
        "icon": "$(terminal)"
      },
      {
        "command": "claudeCodeOrchestrator.togglePreferred",
        "title": "%command.togglePreferred.title%",
        "category": "%command.category%",
        "icon": "$(star)"
      },
      {
        "command": "claudeCodeOrchestrator.accountAction",
        "title": "%command.accountAction.title%",
        "category": "%command.category%"
      },
      {
        "command": "claudeCodeOrchestrator.installMcp",
        "title": "%command.installMcp.title%",
        "category": "%command.category%",
        "icon": "$(plug)"
      },
      {
        "command": "claudeCodeOrchestrator.addDispatchPolicy",
        "title": "%command.addDispatchPolicy.title%",
        "category": "%command.category%",
        "icon": "$(book)"
      },
      {
        "command": "claudeCodeOrchestrator.installTeamAgent",
        "title": "%command.installTeamAgent.title%",
        "category": "%command.category%",
        "icon": "$(person-add)"
      },
      {
        "command": "claudeCodeOrchestrator.updateWorkspaceSetup",
        "title": "%command.updateWorkspaceSetup.title%",
        "category": "%command.category%",
        "icon": "$(sync)"
      },
      {
        "command": "claudeCodeOrchestrator.showTaskOutput",
        "title": "%command.showTaskOutput.title%",
        "category": "%command.category%"
      },
      {
        "command": "claudeCodeOrchestrator.openTaskOutput",
        "title": "%command.openTaskOutput.title%",
        "category": "%command.category%"
      },
      {
        "command": "claudeCodeOrchestrator.clearTasks",
        "title": "%command.clearTasks.title%",
        "category": "%command.category%",
        "icon": "$(clear-all)"
      },
      {
        "command": "claudeCodeOrchestrator.cancelTask",
        "title": "%command.cancelTask.title%",
        "category": "%command.category%",
        "icon": "$(stop-circle)"
      },
      {
        "command": "claudeCodeOrchestrator.cancelAllTasks",
        "title": "%command.cancelAllTasks.title%",
        "category": "%command.category%",
        "icon": "$(stop)"
      },
      {
        "command": "claudeCodeOrchestrator.toggleTaskScope",
        "title": "%command.toggleTaskScope.title%",
        "category": "%command.category%",
        "icon": "$(filter)"
      },
      {
        "command": "claudeCodeOrchestrator.openDashboard",
        "title": "%command.openDashboard.title%",
        "category": "%command.category%",
        "icon": "$(dashboard)"
      },
      {
        "command": "claudeCodeOrchestrator.openSettings",
        "title": "%command.openSettings.title%",
        "category": "%command.category%",
        "icon": "$(gear)"
      },
      {
        "command": "claudeCodeOrchestrator.refreshUsage",
        "title": "%command.refreshUsage.title%",
        "category": "%command.category%",
        "icon": "$(sync)"
      },
      {
        "command": "claudeCodeOrchestrator.resetCheckin",
        "title": "%command.resetCheckin.title%",
        "category": "%command.category%",
        "icon": "$(debug-restart)"
      },
      {
        "command": "claudeCodeOrchestrator.cleanSessionLitter",
        "title": "%command.cleanSessionLitter.title%",
        "category": "%command.category%",
        "icon": "$(trash)"
      },
      {
        "command": "claudeCodeOrchestrator.openAssetManager",
        "title": "%command.openAssetManager.title%",
        "category": "%command.category%",
        "icon": "$(library)"
      },
      {
        "command": "claudeCodeOrchestrator.manageAssets",
        "title": "%command.manageAssets.title%",
        "category": "%command.category%",
        "icon": "$(checklist)"
      },
      {
        "command": "claudeCodeOrchestrator.syncAssets",
        "title": "%command.syncAssets.title%",
        "category": "%command.category%",
        "icon": "$(sync)"
      },
      {
        "command": "claudeCodeOrchestrator.resetAsset",
        "title": "%command.resetAsset.title%",
        "category": "%command.category%",
        "icon": "$(discard)"
      },
      {
        "command": "claudeCodeOrchestrator.sessionAction",
        "title": "%command.sessionAction.title%",
        "category": "%command.category%"
      },
      {
        "command": "claudeCodeOrchestrator.attachSession",
        "title": "%command.attachSession.title%",
        "category": "%command.category%",
        "icon": "$(terminal)"
      },
      {
        "command": "claudeCodeOrchestrator.sessionLogs",
        "title": "%command.sessionLogs.title%",
        "category": "%command.category%",
        "icon": "$(output)"
      },
      {
        "command": "claudeCodeOrchestrator.stopSession",
        "title": "%command.stopSession.title%",
        "category": "%command.category%",
        "icon": "$(stop-circle)"
      },
      {
        "command": "claudeCodeOrchestrator.openSessionDiff",
        "title": "%command.openSessionDiff.title%",
        "category": "%command.category%",
        "icon": "$(diff)"
      },
      {
        "command": "claudeCodeOrchestrator.copySessionName",
        "title": "%command.copySessionName.title%",
        "category": "%command.category%",
        "icon": "$(copy)"
      },
      {
        "command": "claudeCodeOrchestrator.refreshTeam",
        "title": "%command.refreshTeam.title%",
        "category": "%command.category%",
        "icon": "$(refresh)"
      },
      {
        "command": "claudeCodeOrchestrator.clearStoppedWorkers",
        "title": "%command.clearStoppedWorkers.title%",
        "category": "%command.category%",
        "icon": "$(clear-all)"
      },
      {
        "command": "claudeCodeOrchestrator.teamSendMessage",
        "title": "%command.teamSendMessage.title%",
        "category": "%command.category%",
        "icon": "$(comment)"
      },
      {
        "command": "claudeCodeOrchestrator.teamSendToAll",
        "title": "%command.teamSendToAll.title%",
        "category": "%command.category%",
        "icon": "$(comment-discussion)"
      },
      {
        "command": "claudeCodeOrchestrator.teamInterrupt",
        "title": "%command.teamInterrupt.title%",
        "category": "%command.category%"
      },
      {
        "command": "claudeCodeOrchestrator.teamTakeOver",
        "title": "%command.teamTakeOver.title%",
        "category": "%command.category%",
        "icon": "$(terminal)"
      },
      {
        "command": "claudeCodeOrchestrator.teamRelease",
        "title": "%command.teamRelease.title%",
        "category": "%command.category%"
      },
      {
        "command": "claudeCodeOrchestrator.teamStopMember",
        "title": "%command.teamStopMember.title%",
        "category": "%command.category%"
      },
      {
        "command": "claudeCodeOrchestrator.teamRestartMember",
        "title": "%command.teamRestartMember.title%",
        "category": "%command.category%"
      },
      {
        "command": "claudeCodeOrchestrator.teamPauseMember",
        "title": "%command.teamPauseMember.title%",
        "category": "%command.category%"
      },
      {
        "command": "claudeCodeOrchestrator.teamUnpauseMember",
        "title": "%command.teamUnpauseMember.title%",
        "category": "%command.category%"
      },
      {
        "command": "claudeCodeOrchestrator.teamShowActivity",
        "title": "%command.teamShowActivity.title%",
        "category": "%command.category%",
        "icon": "$(output)"
      },
      {
        "command": "claudeCodeOrchestrator.teamShowChanges",
        "title": "%command.teamShowChanges.title%",
        "category": "%command.category%",
        "icon": "$(diff)"
      },
      {
        "command": "claudeCodeOrchestrator.teamCopyBranch",
        "title": "%command.teamCopyBranch.title%",
        "category": "%command.category%"
      },
      {
        "command": "claudeCodeOrchestrator.teamCopyMergeCommand",
        "title": "%command.teamCopyMergeCommand.title%",
        "category": "%command.category%"
      },
      {
        "command": "claudeCodeOrchestrator.teamOpenWorktree",
        "title": "%command.teamOpenWorktree.title%",
        "category": "%command.category%"
      },
      {
        "command": "claudeCodeOrchestrator.teamEnd",
        "title": "%command.teamEnd.title%",
        "category": "%command.category%"
      },
      {
        "command": "claudeCodeOrchestrator.teamAddTask",
        "title": "%command.teamAddTask.title%",
        "category": "%command.category%",
        "icon": "$(add)"
      },
      {
        "command": "claudeCodeOrchestrator.teamAssignTask",
        "title": "%command.teamAssignTask.title%",
        "category": "%command.category%"
      },
      {
        "command": "claudeCodeOrchestrator.teamTaskDone",
        "title": "%command.teamTaskDone.title%",
        "category": "%command.category%"
      },
      {
        "command": "claudeCodeOrchestrator.teamTaskRework",
        "title": "%command.teamTaskRework.title%",
        "category": "%command.category%"
      },
      {
        "command": "claudeCodeOrchestrator.teamTaskCancel",
        "title": "%command.teamTaskCancel.title%",
        "category": "%command.category%"
      },
      {
        "command": "claudeCodeOrchestrator.teamTaskReopen",
        "title": "%command.teamTaskReopen.title%",
        "category": "%command.category%"
      },
      {
        "command": "claudeCodeOrchestrator.teamModeTurnOn",
        "title": "%command.teamModeTurnOn.title%",
        "category": "%command.category%",
        "icon": "$(broadcast)"
      },
      {
        "command": "claudeCodeOrchestrator.teamModeTurnOff",
        "title": "%command.teamModeTurnOff.title%",
        "category": "%command.category%"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "claudeCodeOrchestrator.openDashboard",
          "when": "view == claudeCodeOrchestrator.workers",
          "group": "navigation@0"
        },
        {
          "command": "claudeCodeOrchestrator.addWorker",
          "when": "view == claudeCodeOrchestrator.workers",
          "group": "navigation@1"
        },
        {
          "command": "claudeCodeOrchestrator.importWorkers",
          "when": "view == claudeCodeOrchestrator.workers",
          "group": "navigation@2"
        },
        {
          "command": "claudeCodeOrchestrator.installMcp",
          "when": "view == claudeCodeOrchestrator.workers",
          "group": "navigation@3"
        },
        {
          "command": "claudeCodeOrchestrator.refreshUsage",
          "when": "view == claudeCodeOrchestrator.workers",
          "group": "navigation@4"
        },
        {
          "command": "claudeCodeOrchestrator.openAssetManager",
          "when": "view == claudeCodeOrchestrator.workers",
          "group": "navigation@5"
        },
        {
          "command": "claudeCodeOrchestrator.cleanSessionLitter",
          "when": "view == claudeCodeOrchestrator.workers",
          "group": "1_maintenance@0"
        },
        {
          "command": "claudeCodeOrchestrator.refreshTeam",
          "when": "view == claudeCodeOrchestrator.team",
          "group": "navigation@0"
        },
        {
          "command": "claudeCodeOrchestrator.openDashboard",
          "when": "view == claudeCodeOrchestrator.team",
          "group": "navigation@1"
        },
        {
          "command": "claudeCodeOrchestrator.teamModeTurnOn",
          "when": "view == claudeCodeOrchestrator.team && !claudeCodeOrchestrator.teamModeOn",
          "group": "navigation@2"
        },
        {
          "command": "claudeCodeOrchestrator.installTeamAgent",
          "when": "view == claudeCodeOrchestrator.team",
          "group": "1_setup@0"
        },
        {
          "command": "claudeCodeOrchestrator.openSettings",
          "when": "view == claudeCodeOrchestrator.team",
          "group": "1_setup@1"
        },
        {
          "command": "claudeCodeOrchestrator.cleanSessionLitter",
          "when": "view == claudeCodeOrchestrator.team",
          "group": "2_maintenance@0"
        },
        {
          "command": "claudeCodeOrchestrator.cancelAllTasks",
          "when": "view == claudeCodeOrchestrator.tasks",
          "group": "navigation@0"
        },
        {
          "command": "claudeCodeOrchestrator.toggleTaskScope",
          "when": "view == claudeCodeOrchestrator.tasks",
          "group": "navigation@1"
        },
        {
          "command": "claudeCodeOrchestrator.openDashboard",
          "when": "view == claudeCodeOrchestrator.tasks",
          "group": "navigation@2"
        },
        {
          "command": "claudeCodeOrchestrator.clearTasks",
          "when": "view == claudeCodeOrchestrator.tasks",
          "group": "navigation@3"
        },
        {
          "command": "claudeCodeOrchestrator.clearStoppedWorkers",
          "when": "view == claudeCodeOrchestrator.workerHistory",
          "group": "navigation@0"
        }
      ],
      "view/item/context": [
        {
          "command": "claudeCodeOrchestrator.cancelTask",
          "when": "view == claudeCodeOrchestrator.tasks && viewItem == runningTask",
          "group": "inline"
        },
        {
          "command": "claudeCodeOrchestrator.openWorkerSession",
          "when": "view == claudeCodeOrchestrator.workers && viewItem =~ /^worker\\./",
          "group": "inline"
        },
        {
          "command": "claudeCodeOrchestrator.togglePreferred",
          "when": "view == claudeCodeOrchestrator.workers && viewItem =~ /^worker\\./",
          "group": "1_manage@0"
        },
        {
          "command": "claudeCodeOrchestrator.setWorkerModel",
          "when": "view == claudeCodeOrchestrator.workers && viewItem =~ /^worker\\./",
          "group": "1_manage@1"
        },
        {
          "command": "claudeCodeOrchestrator.setWorkerPermissionMode",
          "when": "view == claudeCodeOrchestrator.workers && viewItem =~ /^worker\\..*\\.permission/",
          "group": "1_manage@2"
        },
        {
          "command": "claudeCodeOrchestrator.renameWorker",
          "when": "view == claudeCodeOrchestrator.workers && viewItem =~ /^worker\\./",
          "group": "1_manage@3"
        },
        {
          "command": "claudeCodeOrchestrator.loginWorker",
          "when": "view == claudeCodeOrchestrator.workers && viewItem =~ /^worker\\.claude(\\.loggedOut)?$/",
          "group": "2_login@0"
        },
        {
          "command": "claudeCodeOrchestrator.reloginWorker",
          "when": "view == claudeCodeOrchestrator.workers && viewItem =~ /^worker\\.(?!claude)|^worker\\.claude\\.loggedOut$/",
          "group": "2_login@1"
        },
        {
          "command": "claudeCodeOrchestrator.checkLoginNow",
          "when": "view == claudeCodeOrchestrator.workers && viewItem =~ /^worker\\.claude/",
          "group": "2_login@2"
        },
        {
          "command": "claudeCodeOrchestrator.removeWorker",
          "when": "view == claudeCodeOrchestrator.workers && viewItem =~ /^worker\\./",
          "group": "9_remove@0"
        },
        {
          "command": "claudeCodeOrchestrator.removeUnsupportedEntry",
          "when": "view == claudeCodeOrchestrator.workers && viewItem == unsupportedWorker",
          "group": "9_remove@0"
        },
        {
          "command": "claudeCodeOrchestrator.attachSession",
          "when": "view == claudeCodeOrchestrator.team && viewItem =~ /\\.attachable/",
          "group": "inline@0"
        },
        {
          "command": "claudeCodeOrchestrator.sessionLogs",
          "when": "view == claudeCodeOrchestrator.team && viewItem =~ /\\.attachable/",
          "group": "inline@1"
        },
        {
          "command": "claudeCodeOrchestrator.attachSession",
          "when": "view == claudeCodeOrchestrator.team && viewItem =~ /\\.attachable/",
          "group": "1_session@0"
        },
        {
          "command": "claudeCodeOrchestrator.sessionLogs",
          "when": "view == claudeCodeOrchestrator.team && viewItem =~ /\\.attachable/",
          "group": "1_session@1"
        },
        {
          "command": "claudeCodeOrchestrator.openSessionDiff",
          "when": "view == claudeCodeOrchestrator.team && viewItem =~ /\\.branch/",
          "group": "1_session@2"
        },
        {
          "command": "claudeCodeOrchestrator.copySessionName",
          "when": "view == claudeCodeOrchestrator.team && viewItem =~ /^session\\./",
          "group": "2_copy@0"
        },
        {
          "command": "claudeCodeOrchestrator.stopSession",
          "when": "view == claudeCodeOrchestrator.team && viewItem =~ /\\.stoppable/",
          "group": "9_stop@0"
        },
        {
          "command": "claudeCodeOrchestrator.teamSendMessage",
          "when": "view == claudeCodeOrchestrator.team && viewItem =~ /^ccoTeam\\.member\\.live\\.active/",
          "group": "inline@0"
        },
        {
          "command": "claudeCodeOrchestrator.teamSendMessage",
          "when": "view == claudeCodeOrchestrator.team && viewItem =~ /^ccoTeam\\.member\\.live\\.active/",
          "group": "1_message@0"
        },
        {
          "command": "claudeCodeOrchestrator.teamInterrupt",
          "when": "view == claudeCodeOrchestrator.team && viewItem =~ /^ccoTeam\\.member\\.live\\.active/",
          "group": "2_turn@0"
        },
        {
          "command": "claudeCodeOrchestrator.teamPauseMember",
          "when": "view == claudeCodeOrchestrator.team && viewItem =~ /^ccoTeam\\.member\\.live\\.active(?!.*\\.paused)/",
          "group": "2_turn@1"
        },
        {
          "command": "claudeCodeOrchestrator.teamUnpauseMember",
          "when": "view == claudeCodeOrchestrator.team && viewItem =~ /^ccoTeam\\.member\\.live.*\\.paused/",
          "group": "2_turn@2"
        },
        {
          "command": "claudeCodeOrchestrator.teamTakeOver",
          "when": "view == claudeCodeOrchestrator.team && viewItem =~ /^ccoTeam\\.member\\.live.*\\.claude/",
          "group": "3_takeover@0"
        },
        {
          "command": "claudeCodeOrchestrator.teamRelease",
          "when": "view == claudeCodeOrchestrator.team && viewItem =~ /^ccoTeam\\.member\\.live.*\\.attached/",
          "group": "3_takeover@1"
        },
        {
          "command": "claudeCodeOrchestrator.teamShowActivity",
          "when": "view == claudeCodeOrchestrator.team && viewItem =~ /^ccoTeam\\.member\\.live/",
          "group": "4_view@0"
        },
        {
          "command": "claudeCodeOrchestrator.teamShowChanges",
          "when": "view == claudeCodeOrchestrator.team && viewItem =~ /^ccoTeam\\.member.*\\.branch/",
          "group": "4_view@1"
        },
        {
          "command": "claudeCodeOrchestrator.teamOpenWorktree",
          "when": "view == claudeCodeOrchestrator.team && viewItem =~ /^ccoTeam\\.member.*\\.branch/",
          "group": "4_view@2"
        },
        {
          "command": "claudeCodeOrchestrator.teamCopyBranch",
          "when": "view == claudeCodeOrchestrator.team && viewItem =~ /^ccoTeam\\.member.*\\.branch/",
          "group": "5_copy@0"
        },
        {
          "command": "claudeCodeOrchestrator.teamCopyMergeCommand",
          "when": "view == claudeCodeOrchestrator.team && viewItem =~ /^ccoTeam\\.member.*\\.branch/",
          "group": "5_copy@1"
        },
        {
          "command": "claudeCodeOrchestrator.teamStopMember",
          "when": "view == claudeCodeOrchestrator.team && viewItem =~ /^ccoTeam\\.member\\.live\\.active/",
          "group": "9_stop@0"
        },
        {
          "command": "claudeCodeOrchestrator.teamRestartMember",
          "when": "view == claudeCodeOrchestrator.team && viewItem =~ /^ccoTeam\\.member\\.live/",
          "group": "9_stop@1"
        },
        {
          "command": "claudeCodeOrchestrator.teamSendToAll",
          "when": "view == claudeCodeOrchestrator.team && viewItem =~ /^ccoTeam\\.team\\.live(?!.*\\.ended)/",
          "group": "1_message@0"
        },
        {
          "command": "claudeCodeOrchestrator.teamAddTask",
          "when": "view == claudeCodeOrchestrator.team && viewItem =~ /^ccoTeam\\.(team|board)\\.live(?!.*\\.ended)/",
          "group": "2_board@0"
        },
        {
          "command": "claudeCodeOrchestrator.teamAddTask",
          "when": "view == claudeCodeOrchestrator.team && viewItem =~ /^ccoTeam\\.board\\.live/",
          "group": "inline@0"
        },
        {
          "command": "claudeCodeOrchestrator.teamEnd",
          "when": "view == claudeCodeOrchestrator.team && viewItem =~ /^ccoTeam\\.team\\.live(?!.*\\.ended)/",
          "group": "9_end@0"
        },
        {
          "command": "claudeCodeOrchestrator.teamAssignTask",
          "when": "view == claudeCodeOrchestrator.team && viewItem =~ /^ccoTeam\\.task\\.(open|claimed|blocked|review)\\.live/",
          "group": "1_task@0"
        },
        {
          "command": "claudeCodeOrchestrator.teamTaskDone",
          "when": "view == claudeCodeOrchestrator.team && viewItem =~ /^ccoTeam\\.task\\.(open|claimed|blocked|review)\\.live/",
          "group": "1_task@1"
        },
        {
          "command": "claudeCodeOrchestrator.teamTaskRework",
          "when": "view == claudeCodeOrchestrator.team && viewItem =~ /^ccoTeam\\.task\\.review\\.live/",
          "group": "1_task@2"
        },
        {
          "command": "claudeCodeOrchestrator.teamTaskReopen",
          "when": "view == claudeCodeOrchestrator.team && viewItem =~ /^ccoTeam\\.task\\.done\\.live/",
          "group": "1_task@3"
        },
        {
          "command": "claudeCodeOrchestrator.teamTaskCancel",
          "when": "view == claudeCodeOrchestrator.team && viewItem =~ /^ccoTeam\\.task\\.(open|claimed|blocked|review|done)\\.live/",
          "group": "9_task@0"
        }
      ],
